name: Publish

on:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: totto2727-org/monorepo/.github/actions/setup-nix@97acf73cf618834a65fb1b82e09185a32e59caf9
      - uses: totto2727-org/monorepo/.github/actions/setup-moonbit@97acf73cf618834a65fb1b82e09185a32e59caf9
      - uses: totto2727-org/monorepo/.github/actions/publish-moonbit@97acf73cf618834a65fb1b82e09185a32e59caf9
        with:
          token: ${{ secrets.MOONCAKES_TOKEN }}
