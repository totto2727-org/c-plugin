name: Publish

on:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: totto2727-org/monorepo/.github/actions/setup-moonbit@1e96bd0df4241d3b5981cc508d74543db54c6c29
      - uses: totto2727-org/monorepo/.github/actions/publish-moonbit@1e96bd0df4241d3b5981cc508d74543db54c6c29
        with:
          token: ${{ secrets.MOONCAKES_TOKEN }}
