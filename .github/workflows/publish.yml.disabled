name: Publish

on:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: totto2727-org/monorepo/.github/actions/setup-moonbit@4d9519caedd113884fbb2f2c8d84f2728984ec8c
      - uses: totto2727-org/monorepo/.github/actions/publish-moonbit@4d9519caedd113884fbb2f2c8d84f2728984ec8c
        with:
          token: ${{ secrets.MOONCAKES_TOKEN }}
