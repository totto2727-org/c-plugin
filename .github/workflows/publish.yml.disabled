name: Publish

on:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: totto2727-org/monorepo/.github/actions/setup-moonbit-sdk@91915accb5ae42bdaac11e5a5de181919c335965
      - uses: totto2727-org/monorepo/.github/actions/publish-moonbit@91915accb5ae42bdaac11e5a5de181919c335965
        with:
          token: ${{ secrets.MOONCAKES_TOKEN }}
