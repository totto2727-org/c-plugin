cabal-version: 3.0
name: c-plugin
version: 0.1.0
synopsis: Ownership-safe plugin skill manager
description: Install Agent Plugins 1.0 and standalone skills from local directories or pinned GitHub sources, and safely reconcile owned symlinks.
category: Tools
author: totto2727
maintainer: totto2727
homepage: https://github.com/totto2727-org/c-plugin
bug-reports: https://github.com/totto2727-org/c-plugin/issues
license: MIT
license-file: LICENSE
build-type: Simple

source-repository head
  type: git
  location: https://github.com/totto2727-org/c-plugin.git

flag static
  description: Link the Linux E2E executable without runtime shared libraries
  default: False
  manual: True

common settings
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
      base >=4.17 && <4.18
    , aeson >=2.1 && <2.3
    , aeson-pretty >=0.8 && <0.9
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.8
    , directory >=1.3 && <1.4
    , filepath >=1.4 && <1.6
    , text >=2.0 && <2.1
    , unix >=2.7 && <2.9
    , yaml >=0.11 && <0.12

library
  import: settings
  hs-source-dirs: hs/lib
  build-depends:
      process >=1.6 && <1.7
    , async >=2.2 && <2.3
    , brick >=2.9 && <2.10
    , vty >=6.4 && <6.5
    , vty-unix >=0.2 && <0.3
    , mtl >=2.2 && <2.4
  exposed-modules:
      CPlugin.Types
      CPlugin.Types.Path
      CPlugin.Types.GitHub
      CPlugin.Types.Source
      CPlugin.Types.Name
      CPlugin.Types.Plugin
      CPlugin.Types.InstalledSkill
      CPlugin.Types.Lock
      CPlugin.Types.Ownership
      CPlugin.Types.PluginManifest
      CPlugin.Types.Skill
      CPlugin.Types.Sync
      CPlugin.Types.Selection
      CPlugin.Interaction
      CPlugin.StateStore
      CPlugin.Paths
      CPlugin.Plugin
      CPlugin.Reconcile
      CPlugin.Commands
      CPlugin.Source.GitHub
  other-modules:
      CPlugin.Interaction.Brick
      CPlugin.Reconcile.Plan
      CPlugin.Reconcile.Session
      CPlugin.Reconcile.Mutation
      CPlugin.Reconcile.Report
      CPlugin.Commands.Init
      CPlugin.Commands.Sync
      CPlugin.Commands.Update
      CPlugin.Commands.PluginAdd
      CPlugin.Commands.SkillAdd
      CPlugin.Commands.PluginAddGitHub
      CPlugin.Commands.SkillAddGitHub
      CPlugin.Commands.Remove
      CPlugin.Commands.PluginRemove
      CPlugin.Commands.SkillRemove
      CPlugin.Commands.List
      CPlugin.Commands.PluginList
      CPlugin.Commands.SkillList
      CPlugin.Commands.Listing
      CPlugin.Commands.PluginSkillEnable
      CPlugin.Commands.PluginSkillDisable
      CPlugin.Commands.PluginSkills
      CPlugin.Commands.TargetAdd
      CPlugin.Commands.TargetRemove
      CPlugin.Commands.Common
      CPlugin.Commands.Batch
      CPlugin.Internal.Validation
      CPlugin.Internal.JSON
      CPlugin.Internal.Concurrent

executable c-plugin
  import: settings
  hs-source-dirs: hs/app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts
  if flag(static) && os(linux)
    ghc-options: -static -optl-static -optl-fuse-ld=bfd
  build-depends:
      c-plugin
    , iris >=0.1 && <0.2
    , optparse-applicative >=0.17 && <0.18
    , transformers >=0.5 && <0.7

test-suite product-tests
  import: settings
  ghc-options: -threaded -rtsopts
  type: exitcode-stdio-1.0
  hs-source-dirs: hs/test
  main-is: Spec.hs
  other-modules:
      CPlugin.PathsSpec
      CPlugin.TypesSpec
      CPlugin.Types.GitHubSpec
      CPlugin.Types.SourceSpec
      CPlugin.GitHubSpec
      CPlugin.GitHubTestSupport
      CPlugin.Types.SelectionSpec
      CPlugin.InteractionSpec
      CPlugin.CodecSpec
      CPlugin.PluginSpec
      CPlugin.ReconcileSpec
      CPlugin.CommandsSpec
      CPlugin.TestSupport
      CPlugin.ConcurrencySpec
  build-depends:
      c-plugin
    , hspec >=2.11 && <2.12
    , temporary >=1.3 && <1.4
    , async >=2.2 && <2.3
