cabal-version: 3.0
name: c-plugin
version: 0.1.0
synopsis: Ownership-safe plugin skill manager
description: Install Agent Plugins 1.0 skills from local plugin directories and safely reconcile owned symlinks.
category: Tools
author: totto2727
maintainer: totto2727
homepage: https://github.com/totto2727-org/c-plugin
bug-reports: https://github.com/totto2727-org/c-plugin/issues
license: MIT
license-file: LICENSE
build-type: Simple

source-repository head
  type: git
  location: https://github.com/totto2727-org/c-plugin.git

common settings
  default-language: Haskell2010
  ghc-options: -Wall
  build-depends:
      base >=4.17 && <4.18
    , aeson >=2.1 && <2.3
    , aeson-pretty >=0.8 && <0.9
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.8
    , directory >=1.3 && <1.4
    , filepath >=1.4 && <1.6
    , text >=2.0 && <2.1
    , unix >=2.7 && <2.9
    , yaml >=0.11 && <0.12

library
  import: settings
  hs-source-dirs: hs-src
  exposed-modules:
      CPlugin.Types
      CPlugin.Codec
      CPlugin.Paths
      CPlugin.Plugin
      CPlugin.Reconcile
      CPlugin.Commands

executable c-plugin
  import: settings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts
  build-depends:
      c-plugin
    , iris >=0.1 && <0.2
    , optparse-applicative >=0.17 && <0.18
    , transformers >=0.5 && <0.7

test-suite product-tests
  import: settings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
      c-plugin
    , hspec >=2.11 && <2.12
    , temporary >=1.3 && <1.4
