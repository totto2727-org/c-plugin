packages: .

-- Resolve only the registry state at least seven days before this migration.
index-state: 2026-10-03T00:00:00Z

-- Iris 0.1 supports GHC 9.4 and these released dependency families.
-- Keep its published bounds intact rather than using allow-newer.
constraints:
  ansi-terminal >=0.11 && <0.12,
  optparse-applicative >=0.17 && <0.18
